# Copy to pipeline/.env — which is gitignored, and must stay that way.
# Scripts load it with `node --env-file=.env` (built into Node 24, no dotenv dependency).

STEEL_API_KEY=
ANTHROPIC_API_KEY=

# Where capture-profile writes the saved Google session.
PROFILE_PATH=./profile.json

# The prepared demo doc: a title + 3-4 section headings as plain text, ready to be styled.
DEMO_DOC_URL=https://docs.google.com/document/d/.../edit
