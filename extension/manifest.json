{
  "manifest_version": 3,
  "name": "Browser Teacher",
  "version": "0.1.0",
  "description": "A teacher that lives in your browser. It points at things and waits for you to click them.",
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:* http://127.0.0.1:*"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lessons/*.json", "src/*", "src/*/*"],
      "matches": ["https://docs.google.com/*", "http://127.0.0.1/*", "http://localhost/*"]
    }
  ]
}
